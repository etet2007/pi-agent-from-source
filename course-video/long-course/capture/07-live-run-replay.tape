Output assets/terminal/07-live-run-replay-vhs.mp4

Require node

Set Shell "zsh"
Set FontSize 21
Set FontFamily "Menlo"
Set LetterSpacing 0.1
Set LineHeight 1.05
Set Width 1440
Set Height 900
Set Padding 30
Set Margin 24
Set MarginFill "#0B0E14"
Set BorderRadius 12
Set WindowBar Colorful
Set WindowBarSize 36
Set Theme "GitHub Dark"
Set Framerate 30
Set TypingSpeed 22ms

Type "node capture/demo-live-run-replay.mjs"
Enter
Sleep 18s
