Output assets/terminal/03-no-tool-trace-vhs.mp4

Require node

Set Shell "zsh"
Set FontSize 23
Set FontFamily "Menlo"
Set LetterSpacing 0.1
Set LineHeight 1.05
Set Width 1440
Set Height 900
Set Padding 30
Set Margin 24
Set MarginFill "#0B0E14"
Set BorderRadius 12
Set WindowBar Colorful
Set WindowBarSize 36
Set Theme "GitHub Dark"
Set Framerate 30
Set TypingSpeed 24ms

Type "./capture/demo-runtime-trace.sh no-tool"
Enter
Sleep 6s
